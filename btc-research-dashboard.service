[Unit]
Description=BTC Research Platform - Dashboard
After=network.target

[Service]
Type=simple
User=btcquant
WorkingDirectory=/opt/btc-research
EnvironmentFile=/opt/btc-research/.env
ExecStart=/opt/btc-research/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
